@model EntityLayer.Concrete.Surecler

@{
	ViewData["Title"] = "SurecGuncelle";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/Unify/assets/vendor/bootstrap-icons/font/bootstrap-icons.css">
<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Süreçler</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Surecler/">Süreçler</a>
							</li>
							<li class="breadcrumb-item" aria-current="page">Süreç Güncelle</li>
							<li class="breadcrumb-item" aria-current="page">@ViewBag.Adi</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="~/Admin/assets/images/breadcrumb/ChatBc-1.png" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-lg-5">
			<div class="card">
				<div class="card-body">
					<h4 class="card-title">Süreç Bilgileri</h4>
					<p class="card-subtitle mb-3">
						&nbsp;
					</p>
					<form method="post" enctype="multipart/form-data">
						<input type="hidden" asp-for="SurecID" />
						<div class="form-floating align-center mb-3">
							<i class="@ViewBag.Ikon fs-12"></i>
						</div>
						<div class="form-floating mb-3">
							<input type="text" asp-for="SurecAdi" class="form-control border border-info" placeholder="Süreç Adı">
							<label>
								<i class="ti ti-user me-2 fs-4 text-info"></i>
								<span class="border-start border-info ps-3">Süreç Adı *</span>
							</label>
						</div>
						<div class="form-floating mb-3">
							<input type="text" asp-for="SurecAciklama" class="form-control border border-info" placeholder="Süreç Özeti">
							<label>
								<i class="ti ti-user me-2 fs-4 text-info"></i>
								<span class="border-start border-info ps-3">Süreç Özeti *</span>
							</label>
						</div>
						<div class="form-floating mb-3">
							<input type="text" asp-for="SurecIkon" class="form-control border border-info" placeholder="Süreç Ikon">
							<label>
								<i class="ti ti-photo me-2 fs-4 text-info"></i>
								<span class="border-start border-info ps-3">Süreç Ikon *</span>
							</label>
						</div>
						<div class="form-floating mb-3">
							@Html.EditorFor(model => model.AktifMi, new { htmlAttributes = new { @class = "form-control border border-info" } })
							<label>
								<i class="ti ti-home me-2 fs-4 text-info"></i>
								<span class="border-start border-info ps-3">Aktif mi?</span>
							</label>
						</div>
						<div class="d-md-flex align-items-center">
							<div class="mt-3 mt-md-0 ms-auto">
								<button type="submit" class="btn btn-info hstack gap-6">
									<i class="ti ti-send me-2 fs-4"></i>
									Kaydet
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
		<div class="col-lg-7">
			<div class="card">
				<div class="card-body">
					<h4 class="card-title">Simgeler</h4>
					<p class="card-subtitle mb-3">
						Süreçlerinizi simgeleyen ikonları bu listeden seçebilirsiniz.
					</p>
					<div class="card-body p-0">
						<iframe class="w-100 h-n280" src="https://icons.getbootstrap.com/" frameborder="0" data-simplebar=""></iframe>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
