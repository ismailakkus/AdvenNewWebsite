@using EntityLayer.Concrete
@model AdvenNewWebsite.Areas.Admin.Models.ProjeModel


@{
	ViewData["Title"] = "ProjeEkle";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Projeler</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Projeler/">Projeler</a>
							</li>
							<li class="breadcrumb-item" aria-current="page">Proje Ekle</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="~/Admin/assets/images/breadcrumb/ChatBc-1.png" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<form method="post" enctype="multipart/form-data">
		<div class="row">
			<div class="col-lg-6">
				<div class="card">
					<div class="card-body">
						<h4 class="card-title">Proje Açıklaması</h4>
						<p class="card-subtitle mb-3">
							&nbsp;
						</p>
						<div class="form-floating mb-3">
							<textarea class="form-control summernote2" cols="10" id="ProjeAciklama" name="ProjeAciklama" rows="5"></textarea>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="card">
					<div class="card-body">
						<h4 class="card-title">Proje Bilgileri</h4>
						<p class="card-subtitle mb-3">
							&nbsp;
						</p>
						<form method="post" enctype="multipart/form-data">
							<div class="form-floating mb-3">
								<input type="text" asp-for="ProjeAdi" class="form-control border border-info" placeholder="Proje Adı">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Adı *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="ProjeOzet" class="form-control border border-info" placeholder="Proje Özeti">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Özeti *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="file" asp-for="ResimUpload" class="form-control border border-info" placeholder="Proje Fotoğrafı">
								<label>
									<i class="ti ti-photo me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Fotoğrafı *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="ProjeKonum" class="form-control border border-info" placeholder="Proje Lokasyonu">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Lokasyonu *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="ProjeKategori" class="form-control border border-info" placeholder="Proje Kategorisi">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Kategorisi *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="ProjeYatirimci" class="form-control border border-info" placeholder="Proje Yatırımcısı">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Yatırımcısı *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<select class="form-control border border-info list-box tri-state" id="ProjeDurum" name="ProjeDurum">
									<option selected="selected" value="">Durum Seçiniz</option>
									<option value="devam">Devam Ediyor</option>
									<option value="tamam">Tamamlandı</option>
									<option value="ileri">İleride</option>
								</select>
								<label>
									<i class="ti ti-home me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Proje Durumu?</span>
								</label>
							</div>
							<div class="d-md-flex align-items-center">
								<div class="mt-3 mt-md-0 ms-auto">
									<button type="submit" class="btn btn-info hstack gap-6">
										<i class="ti ti-send me-2 fs-4"></i>
										Kaydet
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</form>
</div>
