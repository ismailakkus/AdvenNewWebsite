@using EntityLayer.Concrete
@model List<Referanslar>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Referanslar</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
							<li class="breadcrumb-item" aria-current="page">Referanslar</li>
							<li class="breadcrumb-item" aria-current="page">
								<a class="text-muted text-decoration-none" href="/Admin/Referanslar/ReferansEkle/"><span class="badge text-bg-primary">Referans Ekle</span></a>
							</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="~/Admin/assets/images/breadcrumb/ChatBc-1.png" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		@foreach (var item in Model)
		{
			<div class="col-md-6 col-md-4 col-lg-2 d-flex align-items-stretch">
				<div class="card w-100">
					<div class="p-4 d-flex align-items-stretch h-100">
						<div class="row">
							<div class="col-6 col-md-6 d-flex align-items-center">
								<img src="~/Upload/Referanslar/@item.ReferansLogo" class="rounded img-fluid">
							</div>
							<div class="col-6 col-md-6 d-flex align-items-center">
								<div>
									<a href="javascript:void(0)" class="card-title link-primary fw-semibold text-dark">
										@item.ReferansAdi
									</a>
									<p class="card-subtitle mt-1">
										<ul class="list-unstyled mb-0 d-flex align-items-center">
											<li class="position-relative" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Düzenle">
												<a class="d-block text-dark px-2 fs-5 bg-hover-primary nav-icon-hover position-relative z-index-5" href="/Admin/Referanslar/ReferansGuncelle/@item.ReferansID">
													<i class="ti ti-edit"></i>
												</a>
											</li>
											<li class="position-relative" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Sil">
												<a class="text-dark px-2 fs-5 bg-hover-primary nav-icon-hover position-relative z-index-5" href="/Admin/Referanslar/ReferansSil/@item.ReferansID">
													<i class="ti ti-trash"></i>
												</a>
											</li>
										</ul>
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>

</div>