@using EntityLayer.Concrete
@model AdvenNewWebsite.Areas.Admin.Models.KullaniciModel


@{
	ViewData["Title"] = "KullaniciEkle";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Kullanıcılar</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="/Admin/Kullanicilar/">Kullanıcılar</a>
                            </li>
							<li class="breadcrumb-item" aria-current="page">Kullanıcı Ekle</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="~/Admin/assets/images/breadcrumb/ChatBc-1.png" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Kullanıcı Bilgileri</h4>
                    <p class="card-subtitle mb-3">
                        Kullanıcıya ait bilgileri eksiksiz olarak doldurun
                    </p>
                    <form method="post" enctype="multipart/form-data">
                        <div class="form-floating mb-3">
                            <input type="text" asp-for="AdiSoyadi" class="form-control border border-info" placeholder="Adı Soyadı">
                            <label>
                                <i class="ti ti-user me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Adı Soyadı</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="email" asp-for="KullaniciEmail" class="form-control border border-info" placeholder="E-mail">
                            <label>
                                <i class="ti ti-mail me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Email Adresi</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" asp-for="KullaniciSifre"  class="form-control border border-info" placeholder="Şifre">
                            <label>
                                <i class="ti ti-lock me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Şifre</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control border border-info" placeholder="Şifre Tekrarı">
                            <label>
                                <i class="ti ti-lock me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Şifre Tekrarı</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" asp-for="Telefon" class="form-control border border-info" placeholder="Telefon Numarası">
                            <label>
                                <i class="ti ti-phone me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Telefon</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" asp-for="Adres" class="form-control border border-info" placeholder="Adres Bilgisi">
                            <label>
                                <i class="ti ti-world me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Adres</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" asp-for="Notlar" class="form-control border border-info" placeholder="Kişisel Not">
                            <label>
                                <i class="ti ti-notes me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Notlar</span>
                            </label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="file" asp-for="ResimUpload" class="form-control border border-info" placeholder="Profil Fotoğrafı">
                            <label>
                                <i class="ti ti-photo me-2 fs-4 text-info"></i>
                                <span class="border-start border-info ps-3">Profil Fotoğrafı</span>
                            </label>
                        </div>
                        <div class="d-md-flex align-items-center">
                            <div class="mt-3 mt-md-0 ms-auto">
                                <button type="submit" class="btn btn-info hstack gap-6">
                                    <i class="ti ti-send me-2 fs-4"></i>
                                    Kaydet
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
	</div>
</div>
