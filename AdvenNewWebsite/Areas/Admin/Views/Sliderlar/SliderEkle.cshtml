@using EntityLayer.Concrete
@model AdvenNewWebsite.Areas.Admin.Models.SliderModel

@{
	ViewData["Title"] = "SliderEkle";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Sliderlar</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Sliderlar/">Sliderlar</a>
							</li>
							<li class="breadcrumb-item" aria-current="page">Slider Ekle</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="~/Admin/assets/images/breadcrumb/ChatBc-1.png" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<form method="post" enctype="multipart/form-data">
		<div class="row">
			<div class="col-lg-6">
				<div class="card">
					<div class="card-body">
						<h4 class="card-title">Slider Bilgileri</h4>
						<p class="card-subtitle mb-3">
							&nbsp;
						</p>
						<form method="post" enctype="multipart/form-data">
							<div class="form-floating mb-3">
								<input type="text" asp-for="SliderBaslik" class="form-control border border-info" placeholder="Slider Başlığı">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Slider Başlığı *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="SliderAciklama" class="form-control border border-info" placeholder="Slider Açıklama metni">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Slider Açıklama metni *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="text" asp-for="SliderLink" class="form-control border border-info" placeholder="Slider Link">
								<label>
									<i class="ti ti-user me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Slider Link *</span>
								</label>
							</div>
							<div class="form-floating mb-3">
								<input type="file" asp-for="ResimUpload" class="form-control border border-info" placeholder="Slider Fotoğrafı">
								<label>
									<i class="ti ti-photo me-2 fs-4 text-info"></i>
									<span class="border-start border-info ps-3">Slider Fotoğrafı *</span>
								</label>
							</div>
							<div class="d-md-flex align-items-center">
								<div class="mt-3 mt-md-0 ms-auto">
									<button type="submit" class="btn btn-info hstack gap-6">
										<i class="ti ti-send me-2 fs-4"></i>
										Kaydet
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</form>
</div>
