@using EntityLayer.Concrete
@model List<Mesajlar>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Mesajlar</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="/Admin/Home/">Anasayfa</a>
							</li>
							<li class="breadcrumb-item" aria-current="page">Mesajlar</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-center mb-n5">
						<img src="../assets/images/breadcrumb/ChatBc-1.png" alt="modernize-img" class="img-fluid mb-n4">
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="card overflow-hidden chat-application">
		<div class="d-flex w-100">

			<div class="d-flex w-100">
				<div class="min-width-340">
					<div class="border-end user-chat-box h-100">
						<div class="app-chat">
							<ul class="chat-users mh-n100" data-simplebar="">
								@{
									var i = 0;
									foreach (var item in Model)
									{
										var itemClass = i++ == 0 ? "chat-user bg-light-subtle" : "chat-user";
										<li>
											<a href="javascript:void(0)" class="px-4 py-3 bg-hover-light-black d-flex align-items-center @itemClass" id="chat_user_@item.MesajID" data-user-id="@item.MesajID">
												<div class="position-relative w-100 ms-2">
													<div class="d-flex align-items-center justify-content-between mb-2">
														<h6 class="mb-0">@item.GonderenAdSoyad</h6>
														<span class="badge text-bg-primary">@item.MesajKategori</span>
													</div>
													<h6 class="fw-semibold text-dark">
														@item.MesajBaslik
													</h6>
													<div class="d-flex align-items-center justify-content-between">
														<div class="d-flex align-items-center">
															<span>
																<i class="ti ti-star fs-4 me-2 text-dark"></i>
															</span>
															<span class="d-block">
																<i class="ti ti-alert-circle text-muted"></i>
															</span>
														</div>
														<p class="mb-0 fs-2 text-muted">@String.Format("{0:yyyy/MM/dd hh:mm}", item.EklemeTarihi)</p>
													</div>
												</div>
											</a>
										</li>
									}
								}
							</ul>
						</div>
					</div>
				</div>
				<div class="w-100">
					<div class="chat-container h-100 w-100">
						<div class="chat-box-inner-part h-100">
							<div class="chatting-box app-email-chatting-box">
								<div class="position-relative overflow-hidden">
									<div class="position-relative">
										<div class="chat-box email-box mh-n100 p-9" data-simplebar="init">
											@{
												var j = 0;
												foreach (var item in Model)
												{
													var itemClass = j++ == 0 ? "chat active-chat" : "chat";
													<div class="chat-list @itemClass" data-user-id="@item.MesajID">
														<div class="hstack align-items-start mb-7 pb-1 align-items-center justify-content-between flex-wrap gap-6">
															<div class="d-flex align-items-center gap-2">
																<img src="../assets/images/profile/user-8-1.jpg" alt="user8" width="48" height="48" class="rounded-circle">
																<div>
																	<h6 class="fw-semibold mb-0">@item.GonderenAdSoyad</h6>
																	<p class="mb-0">@item.GonderenMail</p>
																</div>
															</div>
															<span class="badge text-bg-primary">@item.MesajKategori</span>
														</div>
														<div class="border-bottom pb-7 mb-7">
															<h4 class="fw-semibold text-dark mb-3">
																@item.MesajBaslik
															</h4>
															<p class="mb-3 text-dark">
															@item.MesajIcerik
															</p>
															<p class="mb-0 text-dark">&nbsp;</p>
															<h6 class="fw-semibold mb-0 text-dark pb-1">
																@String.Format("{0:yyyy/MM/dd hh:mm}", item.EklemeTarihi)
															</h6>
														</div>
														<div class="mb-3">
															<h6 class="fw-semibold mb-0 text-dark mb-3">
																Mail Ekleri
															</h6>
															<div class="d-block d-sm-flex align-items-center gap-4">
																<a href="javascript:void(0)" class="hstack gap-3 mb-2 mb-sm-0">
																	<div class="d-flex align-items-center gap-3">
																		<div class="rounded-1 text-bg-light p-6">
																			<img src="../assets/images/chat/icon-adobe-1.svg" alt="matdash-img" width="24" height="24">
																		</div>
																		<div>
																			<h6 class="fw-semibold">
																				@item.GonderenEk
																			</h6>
																		</div>
																	</div>
																</a>
															</div>
														</div>
													</div>
												}
											}
										</div>
										<div class="px-9 py-3 border-top chat-send-message-footer">
											<div class="d-flex align-items-center justify-content-between">
												<ul class="list-unstyled mb-0 d-flex align-items-center gap-7">
													<li>
														<a class="text-dark bg-hover-primary d-flex align-items-center gap-1" href="javascript:void(0)">
															<i class="ti ti-arrow-back-up fs-5"></i>
															Cevapla
														</a>
													</li>
													<li>
														<a class="text-dark bg-hover-primary d-flex align-items-center gap-1" href="javascript:void(0)">
															<i class="ti ti-arrow-forward-up fs-5"></i>
															İlet
														</a>
													</li>
												</ul>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

