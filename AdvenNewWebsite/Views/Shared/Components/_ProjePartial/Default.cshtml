@using EntityLayer.Concrete
@model List<Projeler>

<div class="container content-space-t-2">
	<!-- Heading -->
	<div class="w-lg-65 text-center mx-lg-auto mb-5 mb-sm-7 mb-lg-10">
		<h2>Tamamlanmış örnek projelerimiz</h2>
		<p>Tesislerinizi, Mühendislik ve tasarım kurallarına göre yaparak projelerinize değer katıyoruz.</p>
	</div>
	<!-- End Heading -->
	@foreach (var item in Model)
	{
		<div class="row justify-content-lg-between align-items-lg-center">
			<div class="col-lg-6 mb-5 mb-lg-0">
				<img class="img-fluid rounded-3" src="~/Upload/Projeler/@item.ProjeResim" alt="@item.ProjeAdi">
			</div>
			<!-- End Col -->

			<div class="col-lg-5">
				<div class="mb-5">
					<h2>@item.ProjeAdi</h2>
					<p>@item.ProjeOzet</p>
				</div>

				<!-- List Checked -->
				<ul class="list-checked list-checked-soft-bg-primary list-checked-lg mb-5">
					<li class="list-checked-item"><span class="fw-bold">Tesis Türü</span> @item.ProjeKategori</li>
					<li class="list-checked-item"><span class="fw-bold">Konum</span> @item.ProjeKonum</li>
					<li class="list-checked-item"><span class="fw-bold">Yatırımcı</span> @item.ProjeYatirimci</li>
					<li class="list-checked-item"><span class="fw-bold">Durum</span> @item.ProjeDurum</li>
					<li class="list-checked-item"><span class="fw-bold">Devreye Alma</span> @String.Format("{0:dd.MM.yyyy}", item.EklemeTarihi)</li>
				</ul>
				<!-- End List Checked -->

				<a class="btn btn-primary" href="#">Detaylar</a>
			</div>
			<!-- End Col -->
		</div>
	}
	<!-- End Row -->
</div>
