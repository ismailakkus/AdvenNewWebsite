@using EntityLayer.Concrete
@model List<Hizmetler>

<!-- Features -->
<div class="overflow-hidden">
	<div class="container content-space-1">
		<!-- Heading -->
		<div class="w-lg-65 text-center mx-lg-auto mb-5 mb-sm-7 mb-lg-10">
            <h2>Hizmet verdiğimiz alanlar</h2>
            <p>Tasarım ve teknolojinin başarılı bir şekilde uygulanmasıyla insan hayatlarını zenginleştiriyoruz</p>
		</div>
		<!-- End Heading -->

		<div class="position-relative content-space-1">
			<div class="row justify-content-lg-between align-items-md-center">
				<div class="col-md-6 col-lg-5 order-md-2 mb-7 mb-md-0">

					<!-- Nav Pills -->
					<ul class="nav nav-pills nav-pills-shadow flex-md-column gap-md-1" id="featuresTab" role="tablist">
						@{
							var i = 0;
							foreach (var item in Model)
							{
								var itemClass = i++ == 0 ? "nav-link active" : "nav-link";
								<li class="nav-item" role="presentation">
									<a class="@itemClass" href="#features-@item.HizmetID" id="features-@item.HizmetID-tab" data-bs-toggle="tab" data-bs-target="#features-@item.HizmetID" role="tab" aria-controls="features-@item.HizmetID" aria-selected="false">
										<!-- Media -->
										<div class="d-flex">

											<div class="flex-grow-1 ms-4">
												<h6 class="text-success mb-1">@item.HizmetAdi</h6>
											</div>
										</div>
										<!-- End Media -->
									</a>
								</li>
							}
						}
					</ul>
					<!-- End Nav Pills -->
				</div>
				<!-- End Col -->

				<div class="col-md-6">
					<div class="position-relative">
						<!-- Tab Content -->
						<div class="tab-content" id="featuresTabContent">
							@{

								var j = 0;
								foreach (var item in Model)
								{
									var itemClass = j++ == 0 ? "tab-pane fade show active" : "tab-pane fade";
									<div class="@itemClass" id="features-@item.HizmetID" role="tabpanel" aria-labelledby="features-@item.HizmetID-tab">
										<img class="img-fluid shadow rounded-3" src="~/Upload/Hizmetler/@item.Foto" alt="@item.HizmetAdi">
									</div>
								}
							}
						</div>
						<!-- End Tab Content -->
						<!-- SVG Shape -->
						<figure class="position-absolute top-0 end-0 mt-n5 me-n10" style="width: 4rem;">
							<img class="img-fluid" src="~/Unify/assets/svg/components/pointer-up.svg" alt="Image Description">
						</figure>
						<!-- End SVG Shape -->
					</div>
				</div>
				<!-- End Col -->
			</div>
			<!-- End Row -->

			<div class="position-absolute top-0 end-0 w-100 w-lg-65 h-65 h-md-100 bg-soft-primary rounded-3 zi-n1 me-n5"></div>
		</div>
	</div>
</div>
<script language="javascript" type="text/javascript">
	$(document).ready(function () {
		$("[id$=nav-link]").addClass("active");
	});
</script>
<!-- End Features -->
